# Referencia local. En servidores define estas variables en el entorno o secret manager.

# ---- Seguridad ----
# Genera una clave secreta unica:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=dev-onne-local-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# SSL: en local debe quedarse apagado.
ENABLE_SSL=False

# ---- Email / Alertas ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=dev@localhost
SERVER_EMAIL=dev@localhost
DJANGO_ADMINS=
PASSWORD_RESET_TIMEOUT=86400

# ---- Logging ----
LOG_LEVEL=DEBUG
LOG_FORMAT=text
LOG_TO_STDOUT=True
LOG_FILE_ENABLED=False
LOG_FILE_PATH=

# ---- Base de datos (PostgreSQL obligatorio para schemas) ----
DB_ENGINE=postgresql
DB_NAME=Binn
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ---- Multi-tenancy ----
TENANT_BASE_DOMAIN=localhost

# Cookies entre subdominios (opcional para SSO)
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=

# ---- Realtime / WebSockets ----
ENABLE_REALTIME=True
# En local puede quedar False para usar InMemoryChannelLayer sin Redis.
REQUIRE_REDIS_FOR_REALTIME=False
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_URL=

# ---- Throttling / Seguridad ----
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=1800

# ---- Workers / Background Jobs ----
ENABLE_BACKGROUND_JOBS=False
# Si no se definen, Celery reutiliza REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Util solo para desarrollo local o tests.
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=True
CELERY_TASK_DEFAULT_QUEUE=binn-default
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_PREFETCH_MULTIPLIER=1
