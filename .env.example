# ---- Seguridad ----
# Genera una clave secreta unica:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-segura
DEBUG=False

# Dominios permitidos (separados por coma, sin espacios)
# Desarrollo: localhost,127.0.0.1,.localhost
# Produccion: .mediecua.com,mediecua.com
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Origenes CSRF confiables (separados por coma)
# Desarrollo: https://localhost
# Produccion: https://app.mediecua.com,https://mediecua.com
CSRF_TRUSTED_ORIGINS=https://localhost

# SSL: activar en produccion con proxy TLS
ENABLE_SSL=False

# ---- Base de datos (PostgreSQL obligatorio para schemas) ----
DB_ENGINE=postgresql
DB_NAME=mediecua
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---- Multi-tenancy ----
# Desarrollo: localhost
# Produccion: mediecua.com
TENANT_BASE_DOMAIN=localhost

# Cookies entre subdominios (opcional para SSO)
# Ejemplo produccion: .mediecua.com
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_DOMAIN=
