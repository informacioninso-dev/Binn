# ---- Seguridad ----
# Genera una clave secreta única: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-segura
DEBUG=False

# Dominios permitidos (separados por coma, sin espacios)
# Desarrollo: localhost,127.0.0.1,.localhost
# Producción: .binnso.com,binnso.com
ALLOWED_HOSTS=localhost,127.0.0.1,.localhost

# Orígenes CSRF confiables (separados por coma)
# Desarrollo: https://localhost
# Producción: https://app.binnso.com,https://binnso.com
CSRF_TRUSTED_ORIGINS=https://localhost

# SSL: activar en producción con Caddy/Nginx + certificado
ENABLE_SSL=False

# ---- Base de datos (PostgreSQL obligatorio para schemas) ----
DB_ENGINE=postgresql
DB_NAME=erp
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---- Multi-tenancy ----
# Desarrollo: localhost
# Producción: binnso.com
TENANT_BASE_DOMAIN=localhost
