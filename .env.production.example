# Copia este archivo a .env.production antes de desplegar.
# Reemplaza todos los valores CHANGE_ME y example.com por datos reales.

# ---- Seguridad ----
SECRET_KEY=change-me-before-prod
DEBUG=False
ALLOWED_HOSTS=app.example.com,.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://*.example.com
TENANT_BASE_DOMAIN=example.com
ENABLE_SSL=True

# Cookies compartidas entre subdominios del tenant.
SESSION_COOKIE_DOMAIN=.example.com
CSRF_COOKIE_DOMAIN=.example.com

# ---- Email / Alertas ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@example.com
SERVER_EMAIL=ops@example.com
DJANGO_ADMINS=Ops:ops@example.com
PASSWORD_RESET_TIMEOUT=86400
EMAIL_TIMEOUT=10

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_STDOUT=True
LOG_FILE_ENABLED=False
LOG_FILE_PATH=/app/logs/binn.log
MALLOC_ARENA_MAX=2
PYTHONMALLOC=malloc

# ---- Base de datos ----
DB_ENGINE=postgresql
DB_NAME=binn
DB_USER=binn_user
DB_PASSWORD=CHANGE_ME
DB_HOST=db
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True
POSTGRES_SHARED_BUFFERS=96MB
POSTGRES_WORK_MEM=2MB
POSTGRES_MAINTENANCE_WORK_MEM=48MB
POSTGRES_EFFECTIVE_CACHE_SIZE=192MB
POSTGRES_MAX_CONNECTIONS=30
POSTGRES_WAL_BUFFERS=4MB
POSTGRES_CHECKPOINT_COMPLETION_TARGET=0.9

# ---- Realtime / Cache ----
ENABLE_REALTIME=True
REQUIRE_REDIS_FOR_REALTIME=True
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
REDIS_MAXMEMORY=96mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ---- Throttling / Seguridad ----
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=1800

# ---- Workers / Background Jobs ----
ENABLE_BACKGROUND_JOBS=True
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_TASK_DEFAULT_QUEUE=binn-default
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_CONCURRENCY=1
CELERY_WORKER_POOL=solo
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
CELERY_WORKER_EXTRA_ARGS=--without-gossip --without-mingle
CELERY_LOG_LEVEL=warning

# ---- Arranque de contenedores ----
RUN_MIGRATIONS_ON_BOOT=0
RUN_COLLECTSTATIC_ON_BOOT=0