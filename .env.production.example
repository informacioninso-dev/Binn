# Referencia para produccion.
# Si levantas con docker compose en este repo, usa DB_HOST=db y redis://redis:6379/...
# Si apuntas a servicios externos, reemplaza esos hosts.

# ---- Seguridad ----
SECRET_KEY=CAMBIAR_POR_CLAVE_LARGA_Y_ALEATORIA
DEBUG=False
ALLOWED_HOSTS=app.binn.example,.binn.example
CSRF_TRUSTED_ORIGINS=https://app.binn.example,https://admin.binn.example

# ---- SSL ----
ENABLE_SSL=True

# ---- Email / Alertas ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.binn.example
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=CAMBIAR_POR_SECRET
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Binn <no-reply@binn.example>
SERVER_EMAIL=alerts@binn.example
DJANGO_ADMINS=Ops:ops@binn.example,CTO:cto@binn.example
PASSWORD_RESET_TIMEOUT=86400

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_TO_STDOUT=True
LOG_FILE_ENABLED=True
LOG_FILE_PATH=/app/logs/binn.log

# ---- Base de datos ----
DB_ENGINE=postgresql
DB_NAME=binn
DB_USER=binn_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_HOST=db
DB_PORT=5432

# ---- Multi-tenancy ----
TENANT_BASE_DOMAIN=binn.example

# Cookies entre subdominios (habilita SSO en *.binn.example)
SESSION_COOKIE_DOMAIN=.binn.example
CSRF_COOKIE_DOMAIN=.binn.example

# ---- Realtime / WebSockets ----
ENABLE_REALTIME=True
REQUIRE_REDIS_FOR_REALTIME=True
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/3

# ---- Throttling / Seguridad ----
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCKOUT_SECONDS=1800

# ---- Workers / Background Jobs ----
ENABLE_BACKGROUND_JOBS=True
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TASK_EAGER_PROPAGATES=False
CELERY_TASK_DEFAULT_QUEUE=binn-default
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240
CELERY_WORKER_PREFETCH_MULTIPLIER=1
