# ---- Seguridad ----
SECRET_KEY=CAMBIAR_POR_CLAVE_LARGA_Y_ALEATORIA
DEBUG=False
ALLOWED_HOSTS=.mediecua.com
CSRF_TRUSTED_ORIGINS=https://app.mediecua.com

# ---- SSL ----
ENABLE_SSL=True

# ---- Base de datos ----
DB_ENGINE=postgresql
DB_NAME=mediecua
DB_USER=mediecua_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_SEGURO
DB_HOST=localhost
DB_PORT=5432

# ---- Multi-tenancy ----
TENANT_BASE_DOMAIN=mediecua.com

# Cookies entre subdominios (habilita SSO en *.mediecua.com)
SESSION_COOKIE_DOMAIN=.mediecua.com
CSRF_COOKIE_DOMAIN=.mediecua.com
